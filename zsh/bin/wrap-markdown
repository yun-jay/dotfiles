#!/usr/bin/env zsh

set -euo pipefail

width=80

usage() {
  print -u2 -- "Usage: $0 [-w width] FILE.md [FILE.md ...]"
}

while getopts ':w:' option; do
  case $option in
    w) width=$OPTARG ;;
    :) print -u2 -- "Option -$OPTARG requires a value"; usage; exit 1 ;;
    \?) print -u2 -- "Unknown option: -$OPTARG"; usage; exit 1 ;;
  esac
done
shift $(( OPTIND - 1 ))

if [[ $width != <-> ]] || (( width < 1 )); then
  print -u2 -- "Width must be a positive integer"
  exit 1
fi

if (( $# == 0 )); then
  usage
  exit 1
fi

for file in "$@"; do
  if [[ ! -f $file ]]; then
    print -u2 -- "File not found: $file"
    exit 1
  fi
done

typeset -i changed=0
typeset temp=''

cleanup() {
  [[ -n $temp ]] && rm -f "$temp"
}
trap cleanup EXIT HUP INT TERM

for file in "$@"; do
  temp=$(mktemp "${TMPDIR:-/tmp}/wrap-markdown.XXXXXX")
  fold -s -w "$width" < "$file" > "$temp"

  if ! cmp -s "$file" "$temp"; then
    cat "$temp" > "$file"
    print -r -- "wrapped $file"
    (( changed += 1 ))
  fi

  rm -f "$temp"
  temp=''
done

print -r -- "Wrapped $changed of $# Markdown files at $width columns."
